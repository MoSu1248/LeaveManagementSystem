@model IEnumerable<EmployeeLeaveRequestListVM>

@{
    ViewData["Title"] = "Index";
}

<h1>Leave Requests</h1>

<p>
    <a asp-action="Create" class = "btn btn-primary">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.LeaveType)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.StartDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EndDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NumberOfDays)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LeaveRequestStatus)
            </th>
           
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
            var className = string.Empty;
            @if (item.LeaveRequestStatus ==
                LeaveManagementSystem.web.Data.LeaveRequestStatusCode.Pending)
            {
                className = "warning";
            }
            else if (item.LeaveRequestStatus ==
                LeaveManagementSystem.web.Data.LeaveRequestStatusCode.Approved)
            {
                className = "success";
            }
            else if (item.LeaveRequestStatus ==
                LeaveManagementSystem.web.Data.LeaveRequestStatusCode.Rejected)
            {
                className = "danger";
            }
            else if (item.LeaveRequestStatus ==
                LeaveManagementSystem.web.Data.LeaveRequestStatusCode.Cancelled)
            {
                className = "dark";
            }
            <tr class="@className">
            <td>
                @Html.DisplayFor(model => item.LeaveType)
            </td>
            <td>
                @Html.DisplayFor(model => item.StartDate)
            </td>
            <td>
                @Html.DisplayFor(model => item.EndDate)
            </td>
            <td>
                @Html.DisplayFor(model => item.NumberOfDays) Days
            </td>
            <td>
                <span class="badge rounded-pill bg-@className">@item.LeaveRequestStatus.ToString()</span>
            </td>
             <td>
                    @if (item.LeaveRequestStatus == LeaveManagementSystem.web.Data.LeaveRequestStatusCode.Pending)
                    {
                        <button type="button" class="btn btn-danger cancelBtn" data-id="@item.Id">
                            Cancel
                        </button>
                    }
            </td>
        </tr>
}
    </tbody>
</table>

<form asp-action="Cancel" id="cancelForm" method="post">
    <input type="hidden" name="leaveRequestId" id="leaveRequestId" />
</form>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(function () {
            $('.cancelBtn').click(function () {
                var id = $(this).data('id');

                Swal.fire({
                    title: 'Are you sure?',
                    text: 'Once cancelled, you will not be able to recover this leave request!',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#dc3545',
                    confirmButtonText: 'Yes, cancel it'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $('#leaveRequestId').val(id);
                        $('#cancelForm').submit();
                    }
                });
            });
        });
    </script>
}