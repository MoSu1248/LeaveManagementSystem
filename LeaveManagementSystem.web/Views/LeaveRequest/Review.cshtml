@using LeaveManagementSystem.web.Data
@model ReviewLeaveRequestVM

@{
    ViewData["Title"] = "Review Leave Request";
}

<h1>Review Leave Request</h1>

<a asp-action="ListRequests" class="btn btn-primary mb-3">Back to List</a>

<hr />

<dl class="row">
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.LeaveType)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.LeaveType)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.StartDate)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.StartDate)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.EndDate)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.EndDate)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.NumberOfDays)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.NumberOfDays)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.RequestComments)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.RequestComments)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.LeaveRequestStatus)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.LeaveRequestStatus)</dd>
</dl>

@if (Model.LeaveRequestStatus == LeaveRequestStatusCode.Pending)
{
    <div class="d-flex gap-2">
            <button type="button" class="btn btn-success reviewBtn" data-form="approveForm" >Approve</button>
            <button type="button" class="btn btn-danger reviewBtn" data-form="rejectForm">Reject</button>
    </div>
    <form asp-action="ApproveRequest" method="post" id="approveForm">
            <input type="hidden" asp-for="LeaveRequestId" />
  </form>

   <form asp-action="RejectRequest" method="post" id="rejectForm">
            <input type="hidden" asp-for="LeaveRequestId" />
   </form>

}
else
{
    <div class="alert alert-info">This request has already been reviewed.</div>
}

  



@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(function(){
            $('.reviewBtn').click(function () {
                
                var formId = $(this).data('form');
                Swal.fire({
                    title: 'Are you sure?',
                    text: "You are about to " + $(this).text().toLowerCase() + " this leave request.",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Yes, proceed!'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $('#' + formId).submit();
                    }
                });
            });
        });
    </script>
}